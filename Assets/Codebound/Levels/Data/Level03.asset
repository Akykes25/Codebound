  m_Name: Level03
  m_EditorClassIdentifier: Codebound.Levels::Codebound.Levels.LevelDefinition
  number: 3
  title: Los pulsos del corredor
  objective: "Encend\xE9 los cuatro m\xF3dulos del corredor y activ\xE1 la terminal
    del final."
  concept: Ciclo for contado
  starterCode: 
  isBoss: 0
  size: {x: 8, y: 3}
  start: {x: 1, y: 1}
  walls: []
  modules:
  - {x: 2, y: 1}
  - {x: 3, y: 1}
  - {x: 4, y: 1}
  - {x: 5, y: 1}
